<project xmlns:artifact="antlib:org.apache.maven.artifact.ant" xmlns:bt="antlib:com.braintribe.build.ant.tasks" basedir="." default="assemble obf" name="tf-js">
	<bt:import artifact="com.braintribe.devrock.ant:gwt-js-library-ant-script#1.0" useCase="DEVROCK" />

	<!-- tf-js is consumed from npm as @dev.hiconic/runtime. Keep the generated
	     legacy packages available in dist, but outside the directories scanned
	     by the generic npm publisher. -->
	<target name="install" depends="assemble">
		<copy file="dist/assembled/${versionedName}.js.zip" tofile="dist/assembled/${versionedName}.js.zip"/>
		<bt:install>
			<pom refid="maven.project"/>
			<attach file="dist/assembled/${versionedName}-min.js.zip" type="min:js.zip"/>
			<attach file="dist/assembled/${versionedName}.js.zip" type=":js.zip"/>
			<attach file="asset.man" type="asset:man"/>
		</bt:install>

		<move file="${dist}/npm" tofile="${dist}/legacy-npm"/>
		<move file="${dist}/npm-pretty" tofile="${dist}/legacy-npm-pretty"/>
	</target>
</project>
